# ─────────────────────────────────────────────────────────────
# SickDoc environment template — placeholders only, no secrets.
# Copy to .env for local development, or set these in your
# shell / CI / platform when running docker compose.
# ─────────────────────────────────────────────────────────────

# --- Database (db service) ---
POSTGRES_USER=sickdoc
POSTGRES_PASSWORD=sickdoc
POSTGRES_DB=sickdoc
# Host port the db container publishes (set 5433 if a local Postgres uses 5432).
POSTGRES_PORT=5432

# --- API ---
# Connection string for local `pnpm dev` (host is `localhost`).
# The docker-compose `api` service overrides the host to `db`.
DATABASE_URL=postgresql://sickdoc:sickdoc@localhost:5432/sickdoc?schema=public

# Signing secret for access/refresh JWTs. Generate a real one for production.
JWT_SECRET=change-me-in-production

# Token lifetimes in seconds. Access: 15 min, refresh: 7 days.
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Allowed web origin for CORS.
CORS_ORIGIN=http://localhost:3000

# API listen port (default 3001).
PORT=3001

# --- Web ---
# Base URL of the REST API (browser-reachable, includes the /api prefix).
NEXT_PUBLIC_API_URL=http://localhost:3001/api
