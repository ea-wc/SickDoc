// SickDoc — PostgreSQL via Prisma. Source of truth: docs/DATA_MODEL.md.
// All ids are uuid generated by the database; all timestamps are timestamptz in UTC.
// Clinical content is fictional and the product carries a prototype disclaimer.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum DoctorStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  RESCHEDULED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum SessionStatus {
  SCHEDULED
  JOINED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum CancelledBy {
  PATIENT
  DOCTOR
  ADMIN
  SYSTEM
}

enum NotificationType {
  APPOINTMENT_BOOKED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_CANCELLED
  APPOINTMENT_REMINDER
  SCHEDULE_CHANGED
  CONSULTATION_READY
  NOTE_AVAILABLE
  PRESCRIPTION_ISSUED
  DOCTOR_PROFILE_REVIEWED
  ACCOUNT_STATUS_CHANGED
}

enum AuditAction {
  USER_ACTIVATED
  USER_SUSPENDED
  USER_DEACTIVATED
  DOCTOR_APPROVED
  DOCTOR_REJECTED
  DOCTOR_PROFILE_UPDATED
  APPOINTMENT_CANCELLED
  APPOINTMENT_RESOLVED
}

// ───────────────────────────── Identity and access ─────────────────────────────

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique @db.Citext
  passwordHash    String
  role            Role
  status          UserStatus @default(ACTIVE)
  statusReason    String?
  statusChangedAt DateTime?  @db.Timestamptz(6)
  lastLoginAt     DateTime?  @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(6)

  patientProfile    PatientProfile?
  doctorProfile     DoctorProfile?   @relation("DoctorProfileUser")
  reviewedDoctors   DoctorProfile[]  @relation("DoctorReviewer")
  refreshTokens     RefreshToken[]
  notifications     Notification[]
  consultationNotes ConsultationNote[]
  prescriptions     Prescription[]
  auditLogs         AuditLog[]

  @@index([role, status])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String
  expiresAt DateTime  @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

// ───────────────────────────── Profiles ─────────────────────────────

model PatientProfile {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @db.Uuid
  firstName      String
  lastName       String
  birthDate      DateTime? @db.Date
  sex            String?
  weightKg       Decimal?  @db.Decimal(5, 2)
  heightCm       Decimal?  @db.Decimal(5, 2)
  phone          String?
  addressLine    String?
  city           String?
  country        String?
  medicalHistory String?
  allergies      String[]  @default([])
  conditions     String[]  @default([])
  avatarColor    String
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  prescriptions Prescription[]

  @@map("patient_profiles")
}

model DoctorProfile {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @unique @db.Uuid
  firstName         String
  lastName          String
  title             String?
  bio               String?
  licenseNumber     String       @unique
  yearsOfExperience Int          @default(0)
  consultationFee   Decimal?     @db.Decimal(10, 2)
  languages         String[]     @default([])
  timezone          String
  status            DoctorStatus @default(PENDING)
  reviewedByUserId  String?      @db.Uuid
  reviewedAt        DateTime?    @db.Timestamptz(6)
  reviewNote        String?
  avatarColor       String
  createdAt         DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(6)

  user                   User                     @relation("DoctorProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy             User?                    @relation("DoctorReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  specializations        DoctorSpecialization[]
  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  appointments           Appointment[]

  @@index([status])
  @@map("doctor_profiles")
}

model Specialization {
  id          String  @id @default(uuid()) @db.Uuid
  slug        String  @unique
  name        String
  description String?
  iconKey     String?

  doctorLinks  DoctorSpecialization[]
  symptomLinks SymptomSpecialty[]

  @@map("specializations")
}

model DoctorSpecialization {
  doctorProfileId  String  @db.Uuid
  specializationId String  @db.Uuid
  isPrimary        Boolean @default(false)

  doctor         DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  specialization Specialization @relation(fields: [specializationId], references: [id], onDelete: Cascade)

  @@id([doctorProfileId, specializationId])
  @@map("doctor_specializations")
}

// ───────────────────────────── Scheduling ─────────────────────────────

model AvailabilityRule {
  id              String    @id @default(uuid()) @db.Uuid
  doctorProfileId String    @db.Uuid
  weekday         Int
  startMinute     Int
  endMinute       Int
  slotMinutes     Int       @default(30)
  effectiveFrom   DateTime? @db.Date
  effectiveTo     DateTime? @db.Date
  isActive        Boolean   @default(true)

  doctor DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)

  @@index([doctorProfileId, weekday])
  @@map("availability_rules")
}

model AvailabilityException {
  id              String   @id @default(uuid()) @db.Uuid
  doctorProfileId String   @db.Uuid
  startsAt        DateTime @db.Timestamptz(6)
  endsAt          DateTime @db.Timestamptz(6)
  reason          String?

  doctor DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)

  @@index([doctorProfileId, startsAt])
  @@map("availability_exceptions")
}

model Appointment {
  id                 String            @id @default(uuid()) @db.Uuid
  patientProfileId   String            @db.Uuid
  doctorProfileId    String            @db.Uuid
  startsAt           DateTime          @db.Timestamptz(6)
  endsAt             DateTime          @db.Timestamptz(6)
  status             AppointmentStatus @default(CONFIRMED)
  reason             String
  symptomIds         String[]          @default([])
  rescheduledFromId  String?           @db.Uuid
  cancelledAt        DateTime?         @db.Timestamptz(6)
  cancelledBy        CancelledBy?
  cancellationReason String?
  createdAt          DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(6)

  patient          PatientProfile       @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  doctor           DoctorProfile        @relation(fields: [doctorProfileId], references: [id], onDelete: Restrict)
  rescheduledFrom  Appointment?         @relation("AppointmentReschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo    Appointment[]        @relation("AppointmentReschedule")
  session          ConsultationSession?
  note             ConsultationNote?
  prescriptions    Prescription[]

  @@index([doctorProfileId, startsAt])
  @@index([patientProfileId, startsAt])
  @@index([status])
  @@map("appointments")
}

// ───────────────────────────── Consultation and records ─────────────────────────────

model ConsultationSession {
  id              String        @id @default(uuid()) @db.Uuid
  appointmentId   String        @unique @db.Uuid
  status          SessionStatus @default(SCHEDULED)
  patientJoinedAt DateTime?     @db.Timestamptz(6)
  doctorJoinedAt  DateTime?     @db.Timestamptz(6)
  startedAt       DateTime?     @db.Timestamptz(6)
  endedAt         DateTime?     @db.Timestamptz(6)
  durationSeconds Int?

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("consultation_sessions")
}

model ConsultationNote {
  id            String    @id @default(uuid()) @db.Uuid
  appointmentId String    @unique @db.Uuid
  authorUserId  String    @db.Uuid
  subjective    String?
  objective     String?
  assessment    String
  plan          String
  summary       String
  followUpAt    DateTime? @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  author      User        @relation(fields: [authorUserId], references: [id], onDelete: Restrict)

  @@map("consultation_notes")
}

model Prescription {
  id               String    @id @default(uuid()) @db.Uuid
  appointmentId    String    @db.Uuid
  issuedByUserId   String    @db.Uuid
  patientProfileId String    @db.Uuid
  issuedAt         DateTime  @default(now()) @db.Timestamptz(6)
  notes            String?
  validUntil       DateTime? @db.Date

  appointment Appointment      @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  issuedBy    User             @relation(fields: [issuedByUserId], references: [id], onDelete: Restrict)
  patient     PatientProfile   @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  items       PrescriptionItem[]

  @@index([patientProfileId, issuedAt(sort: Desc)])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String  @id @default(uuid()) @db.Uuid
  prescriptionId String  @db.Uuid
  drugName       String
  dosage         String
  frequency      String
  durationDays   Int?
  instructions   String?

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@map("prescription_items")
}

// ───────────────────────────── Matching ─────────────────────────────

model Symptom {
  id         String   @id @default(uuid()) @db.Uuid
  slug       String   @unique
  label      String
  synonyms   String[] @default([])
  bodySystem String?

  specialtyLinks SymptomSpecialty[]

  @@map("symptoms")
}

model SymptomSpecialty {
  symptomId        String @db.Uuid
  specializationId String @db.Uuid
  weight           Int

  symptom        Symptom        @relation(fields: [symptomId], references: [id], onDelete: Cascade)
  specialization Specialization @relation(fields: [specializationId], references: [id], onDelete: Cascade)

  @@id([symptomId, specializationId])
  @@map("symptom_specialties")
}

// ───────────────────────────── Notifications and audit ─────────────────────────────

model Notification {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @db.Uuid
  type          NotificationType
  title         String
  body          String
  appointmentId String?          @db.Uuid
  readAt        DateTime?        @db.Timestamptz(6)
  createdAt     DateTime         @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  actorUserId String      @db.Uuid
  action      AuditAction
  entityType  String
  entityId    String      @db.Uuid
  reason      String?
  metadata    Json?
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)

  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
